// Runtime configuration of the React Twake Mail, rendered by compose-wrapper.sh
// into env.js and mounted as /.env.js (see public/.env.example.js of the app).

// Same origin: Traefik sends /jmap, /upload, /download, /eventSource and
// /.well-known/jmap of this host to tmail-backend (docker-compose.yml).
var SERVER_URL = "https://mail-react.${BASE_DOMAIN}";

var AUTH_MODE = "oidc";
var SSO_BASE_URL = "https://auth.${BASE_DOMAIN}/";
var WEB_OIDC_CLIENT_ID = "twake-mail-react";
var OIDC_SCOPES = "openid,profile,email,offline_access";
var SSO_REDIRECT_URI = "https://mail-react.${BASE_DOMAIN}/callback";
var SSO_POST_LOGOUT_REDIRECT = "https://mail-react.${BASE_DOMAIN}/";

// "See in your Calendar" of the invitation cards
var CALENDAR_SPA_URL = "https://calendar.${BASE_DOMAIN}";

// Twake Drive file picker (intent PICK io.cozy.files) in the composer, on the
// user's own Cozy; cozy-stack swaps the OIDC token for one of the mail app
// (app_token_exchange in cozy.yaml).
var TDRIVE_ENABLED = true;
var TDRIVE_INTENT_URL = "https://{localpart}.${BASE_DOMAIN}";

// Framed by the Cozy Mail app when mail.embedded-app-url points here.
var WORKPLACE_EMBEDDING = true;

// Twake Space frames the team mailbox facade (/embed/team-mailboxes/<id>).
var TWAKE_SPACE_URL = "https://space.${BASE_DOMAIN}";
