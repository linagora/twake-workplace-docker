BASE_DOMAIN=twake.local
LDAP_BASE_DN=dc=twake,dc=local
MAIL_DOMAIN=twake.local
RABBITMQ_DECLARE_EXCHANGES=auth,b2b

# Certificate mode: self-signed (default) or letsencrypt
# For letsencrypt, certbot must have already generated certs at:
# /etc/letsencrypt/live/${BASE_DOMAIN}/
CERT_MODE=self-signed

# RabbitMQ credentials — must match RABBITMQ_DEFAULT_USER/PASS in
# twake_db/docker-compose.yml. ldap-rest's cozyProvision plugin uses these
# to connect to amqp://rabbitmq:5672/.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

LDAP_REST_ADMIN_TOKEN=demo-twpdocker-admin-token
LDAP_REST_APP_TOKEN=demo-twpdocker-app-token

# cozy-stack admin API credentials — must match COZY_ADMIN_PASSPHRASE in
# cozy_stack/docker-compose.yml. Used by ldap-rest's cozyProvision plugin
# to POST /instances after a SCIM user is created.
COZY_ADMIN_PASSPHRASE=admin

# Same constant for every user we provision in this deployment. cozy-stack
# uses (OrgID, OrgDomain) to group instances together for sharing /
# autocomplete; OrgDomain defaults to BASE_DOMAIN.
COZY_ORG_ID=twp-docker
