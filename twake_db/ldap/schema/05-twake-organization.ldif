# The organization of a user, as in the Twake Workplace B2B directory
# (twake-ldap-rest schema, same OIDs): twakeOrganizationId is exported by
# LemonLDAP as the org_id claim Twake Space and Twake Tasks require, and
# twakeOrganizationRole as org_role. The B2B schema carries them on its
# twakeAccount class, which this LDAP already defines otherwise: they hang on
# twakeOrganizationMember here.
# No blank line inside the record: it would end the LDIF entry early.
dn: cn=twakeOrganization,cn=schema,cn=config
objectClass: olcSchemaConfig
cn: twakeOrganization
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.1.45
  NAME 'twakeOrganizationId'
  DESC 'Organization ID for B2B users'
  EQUALITY caseIgnoreMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{64}
  SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.1.7
  NAME 'twakeOrganizationRole'
  DESC 'User role in organization: owner, admin, moderator, or member'
  EQUALITY caseIgnoreMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{32}
  SINGLE-VALUE )
olcObjectClasses: ( 1.3.6.1.4.1.99999.2.10
  NAME 'twakeOrganizationMember'
  DESC 'Member of a Twake Workplace organization'
  SUP top AUXILIARY
  MAY ( twakeOrganizationId $ twakeOrganizationRole ) )
