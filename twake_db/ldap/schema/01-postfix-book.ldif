# Mail-related attributes referenced by the Twake schema (02-twake.ldif).
# Defines mailAlternateAddress, mailHost, mailQuotaSize, mailReplyText and
# mailForwardingAddress under a private OID arc (1.3.6.1.4.1.99999) so the
# Twake schema can resolve them.
#
# This file is named 01-postfix-book.ldif on purpose. osixia/openldap ships
# its own postfix-book schema (which only defines mailForwardingAddress
# among those) and processes custom/*.ldif before the bundled schemas.
# Registering our schema under `cn=postfix-book` first makes osixia's
# `is_new_schema` helper skip the bundled one, avoiding a duplicate
# attributeType conflict that would otherwise abort the bootstrap before
# users.ldif runs.
#
# personalTitle is already provided by the default cosine.schema.
dn: cn=postfix-book,cn=schema,cn=config
objectClass: olcSchemaConfig
cn: postfix-book
olcAttributeTypes: {0}( 1.3.6.1.4.1.99999.2.1.1 NAME 'mailAlternateAddress' DESC 'Alternate email address' EQUALITY caseIgnoreIA5Match SUBSTR caseIgnoreIA5SubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.26{256} )
olcAttributeTypes: {1}( 1.3.6.1.4.1.99999.2.1.2 NAME 'mailHost' DESC 'Mail server host' EQUALITY caseIgnoreIA5Match SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 SINGLE-VALUE )
olcAttributeTypes: {2}( 1.3.6.1.4.1.99999.2.1.3 NAME 'mailQuotaSize' DESC 'Mail quota size in bytes' EQUALITY integerMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.27 SINGLE-VALUE )
olcAttributeTypes: {3}( 1.3.6.1.4.1.99999.2.1.4 NAME 'mailForwardingAddress' DESC 'Mail forwarding address' EQUALITY caseIgnoreIA5Match SUBSTR caseIgnoreIA5SubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.26{256} )
olcAttributeTypes: {4}( 1.3.6.1.4.1.99999.2.1.5 NAME 'mailReplyText' DESC 'Mail auto-reply text' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
