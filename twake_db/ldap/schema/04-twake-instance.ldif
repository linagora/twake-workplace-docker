# A class of its own rather than a change to twakeUser: OpenLDAP 2.4 cannot
# rewrite an objectClass already loaded in cn=config, so existing directories
# could not pick the change up.
# No blank line inside the record: it would end the LDIF entry early.
dn: cn=twakeInstance,cn=schema,cn=config
objectClass: olcSchemaConfig
cn: twakeInstance
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.14
  NAME 'twakeCreatedEventAt'
  DESC 'Creation event publication timestamp in ISO 8601 format'
  EQUALITY caseIgnoreMatch
  ORDERING caseIgnoreOrderingMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{32}
  SINGLE-VALUE )
olcObjectClasses: ( 1.3.6.1.4.1.99999.2.2
  NAME 'twakeInstance'
  DESC 'Workplace instance state of a Twake account'
  SUP top AUXILIARY
  MAY ( twakeCreatedEventAt ) )
