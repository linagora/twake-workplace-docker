port: 7880

rtc:
  # Single-port UDP mux: all media flows over udp_port (7881). port_range_*
  # is intentionally unset, LiveKit ignores it whenever udp_port is set.
  udp_port: 7881
  tcp_port: 7881
  # false (local) advertises the container IP; true lets LiveKit auto-detect
  # the host's public IP via STUN so remote browsers get a routable candidate.
  use_external_ip: ${LIVEKIT_USE_EXTERNAL_IP}
turn:
  enabled: true
  udp_port: 443

keys:
#  <LIVEKIT_API_KEY>: <LIVEKIT_API_SECRET>
  9f3b2c7a8e6d4f1c: 6a9d0a3f5e4b8c2f9a7d6e3c1b4f8a2e



redis:
  address: valkey:6379
  password: valkeypass


logging:
  level: info
