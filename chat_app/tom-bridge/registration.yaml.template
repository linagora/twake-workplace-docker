# Synapse application service registration of tom-bridge, rendered by
# compose-wrapper.sh into registration.yaml; its random tokens are generated
# once and kept.
id: common-settings-bridge
url: null
as_token: "${TOM_BRIDGE_AS_TOKEN}"
hs_token: "${TOM_BRIDGE_HS_TOKEN}"
sender_localpart: twp_bot
namespaces:
  users:
    - exclusive: false
      regex: "@.*"
  rooms: []
  # The Matrix spaces of Twake Space spaces and their General rooms
  # (spaces block of the config): Synapse refuses to create them otherwise
  aliases:
    - exclusive: true
      regex: '#twake-space-.*:${BASE_DOMAIN_REGEX}$'
rate_limited: false
